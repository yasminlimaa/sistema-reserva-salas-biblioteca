# Copie para .env.local e preencha. Nunca coloque service_role aqui: só a chave anon vai ao navegador.

# mock     -> demonstração, sem backend nem banco
# api      -> backend REST do grupo (VITE_API_URL)
# supabase -> Supabase Auth (VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY)
VITE_AUTH_PROVIDER=mock

VITE_API_URL=http://localhost:3000

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
