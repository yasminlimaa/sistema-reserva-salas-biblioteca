# Copie para .env.local e preencha. Nunca coloque service_role aqui: só a chave anon vai ao navegador.

# mock     -> demonstração, sem backend nem banco
# api      -> backend REST do grupo (VITE_API_URL)
# supabase -> Supabase Auth (VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY)
VITE_AUTH_PROVIDER=mock

# Provedor usado somente pela tela Disponibilidade. O padrao preserva a demonstracao.
# api exige token real em memoria e usa VITE_SALAS_API_URL/VITE_RESERVAS_API_URL.
VITE_DISPONIBILIDADE_PROVIDER=mock

VITE_API_URL=http://localhost:3000

# Camada de Reservas (ainda não está ligada às telas). Valores relativos usam
# o proxy de desenvolvimento configurado em vite.config.js.
VITE_USUARIOS_API_URL=/api/usuarios
VITE_SALAS_API_URL=/api/salas
VITE_RESERVAS_API_URL=/api/reservas

# Opcional: destinos do proxy Vite. Não são credenciais e não são expostos ao navegador.
USUARIOS_API_PROXY_TARGET=http://127.0.0.1:3003
SALAS_API_PROXY_TARGET=http://127.0.0.1:3002
RESERVAS_API_PROXY_TARGET=http://127.0.0.1:3001

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
